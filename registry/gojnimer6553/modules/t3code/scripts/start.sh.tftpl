#!/bin/bash

set -euo pipefail

ARG_PORT='${ARG_PORT}'
# Double-quoted: these values contain a literal "$HOME" that must be expanded
# by this shell at runtime, not treated as a literal string.
ARG_MODULE_DIRECTORY="${ARG_MODULE_DIRECTORY}"
ARG_INSTALL_PREFIX="${ARG_INSTALL_PREFIX}"
ARG_RESTART_ON_KILL='${ARG_RESTART_ON_KILL}'
ARG_RESTART_DELAY_SECONDS='${ARG_RESTART_DELAY_SECONDS}'
ARG_MAX_RESTART_ATTEMPTS='${ARG_MAX_RESTART_ATTEMPTS}'
ARG_ADDITIONAL_ARGUMENTS=$(echo -n '${ARG_ADDITIONAL_ARGUMENTS}' | base64 -d)
ARG_EXTERNAL_URL=$(echo -n '${ARG_EXTERNAL_URL}' | base64 -d)
ARG_PAIRING_TTL='${ARG_PAIRING_TTL}'

T3_BIN="$${ARG_INSTALL_PREFIX}/node_modules/.bin/t3"
SCRIPTS_DIR="$${ARG_MODULE_DIRECTORY}/scripts"
LOG_PATH="$${ARG_MODULE_DIRECTORY}/logs/start.log"
LAUNCHER_PATH="$${SCRIPTS_DIR}/t3-launcher.sh"

if [ ! -x "$T3_BIN" ]; then
  echo "❌ t3 binary not found at $T3_BIN. Did the install script run and succeed?"
  exit 1
fi

mkdir -p "$SCRIPTS_DIR" "$(dirname "$LOG_PATH")"

# Mint an additional pairing link scoped to the public URL, before starting
# the server, so this one-off CLI invocation (which operates directly on the
# SQLite auth database) never races the server's own DB migrations. T3
# Code's auto-issued startup pairing token only lasts 5 minutes, so this
# gives a much longer-lived link for external/remote pairing.
#
# This writes to this script's own stdout/stderr (captured into LOG_PATH by
# the coder-utils wrapper that invokes this script), not to LOG_PATH
# directly: that wrapper's `tee` truncates LOG_PATH when its pipe opens, and
# a direct write here can race that truncation and be silently wiped.
if [ -n "$ARG_EXTERNAL_URL" ]; then
  echo "🔗 Minting an external pairing link for $ARG_EXTERNAL_URL (ttl: $ARG_PAIRING_TTL)..."
  if ! "$T3_BIN" auth pairing create --ttl "$ARG_PAIRING_TTL" --base-url "$ARG_EXTERNAL_URL" --label coder-external; then
    echo "⚠️ Failed to mint an external pairing link; see the output above. The in-workspace app and its own startup pairing link are unaffected."
  fi
fi

# Materialize a standalone launcher so the actual "t3 serve" process is a
# detached grandchild of this coder_script, not a direct child of it. That
# lets this script return immediately (required for run_on_start) while the
# launcher keeps supervising/restarting the server on its own.
cat > "$LAUNCHER_PATH" << EOF_LAUNCHER
#!/bin/bash
restart_attempt=0
while true; do
  $(printf '%q' "$T3_BIN") serve --port $(printf '%q' "$${ARG_PORT}") $${ARG_ADDITIONAL_ARGUMENTS}
  exit_code=\$?
  ts="\$(date -Iseconds 2> /dev/null || date)"
  echo "[\$ts] t3 serve exited with code \$exit_code."
  if [ "$${ARG_RESTART_ON_KILL}" != "true" ]; then
    break
  fi
  if [ "$${ARG_MAX_RESTART_ATTEMPTS}" != "0" ] && [ "\$restart_attempt" -ge "$${ARG_MAX_RESTART_ATTEMPTS}" ]; then
    echo "[\$ts] Reached max_restart_attempts ($${ARG_MAX_RESTART_ATTEMPTS}); giving up."
    break
  fi
  restart_attempt=\$((restart_attempt + 1))
  echo "[\$ts] Restarting t3 serve in $${ARG_RESTART_DELAY_SECONDS}s (attempt \$restart_attempt)..."
  sleep $(printf '%q' "$${ARG_RESTART_DELAY_SECONDS}")
done
EOF_LAUNCHER

chmod +x "$LAUNCHER_PATH"

echo "🚀 Starting T3 Code server on port $${ARG_PORT}..."
echo "ℹ️ First-time browser access requires pairing. Look below for a line starting with 'Pairing URL:' (or scan the printed QR code) the first time you open the app in a given browser."

nohup "$LAUNCHER_PATH" >> "$LOG_PATH" 2>&1 &
disown

echo "T3 Code launcher started (pid $!). Logs: $LOG_PATH"
