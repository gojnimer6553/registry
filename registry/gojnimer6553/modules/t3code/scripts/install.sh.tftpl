#!/bin/bash

set -euo pipefail

BOLD='\033[0;1m'

command_exists() {
  command -v "$1" > /dev/null 2>&1
}

ARG_INSTALL='${ARG_INSTALL}'
ARG_USE_CACHED='${ARG_USE_CACHED}'
ARG_VERSION='${ARG_VERSION}'
ARG_PACKAGE_MANAGER='${ARG_PACKAGE_MANAGER}'
ARG_REGISTRY_URL='${ARG_REGISTRY_URL}'
ARG_NODE_VERSION='${ARG_NODE_VERSION}'
# Double-quoted: this value contains a literal "$HOME" that must be expanded
# by this shell at runtime, not treated as a literal string.
ARG_INSTALL_PREFIX="${ARG_INSTALL_PREFIX}"

echo "--------------------------------"
printf "ARG_INSTALL: %s\n" "$${ARG_INSTALL}"
printf "ARG_USE_CACHED: %s\n" "$${ARG_USE_CACHED}"
printf "ARG_VERSION: %s\n" "$${ARG_VERSION}"
printf "ARG_PACKAGE_MANAGER: %s\n" "$${ARG_PACKAGE_MANAGER}"
printf "ARG_REGISTRY_URL: %s\n" "$${ARG_REGISTRY_URL}"
printf "ARG_NODE_VERSION: %s\n" "$${ARG_NODE_VERSION}"
printf "ARG_INSTALL_PREFIX: %s\n" "$${ARG_INSTALL_PREFIX}"
echo "--------------------------------"

if [ "$${ARG_INSTALL}" != "true" ]; then
  echo "⏭️  install=false; skipping T3 Code installation."
  exit 0
fi

# T3 Code (published as the "t3" npm package) is a Node.js application and
# needs a Node.js runtime satisfying its engines requirement
# (^22.16 || ^23.11 || >=24.10). When the workspace image does not provide
# one, bootstrap a pinned runtime into $HOME so it persists across restarts.
ensure_node() {
  if command_exists node; then
    return 0
  fi

  local node_arch node_dir
  case "$(uname -m)" in
    x86_64 | amd64) node_arch="x64" ;;
    aarch64 | arm64) node_arch="arm64" ;;
    *)
      echo "❌ node is required to run T3 Code but was not found on PATH, and automatic bootstrap does not support architecture '$(uname -m)'."
      exit 1
      ;;
  esac

  node_dir="$HOME/.local/share/coder-t3code/node-v$${ARG_NODE_VERSION}-linux-$${node_arch}"
  if [ ! -x "$node_dir/bin/node" ]; then
    echo "⚠️ node not found on PATH; bootstrapping Node.js v$${ARG_NODE_VERSION} into $node_dir..."
    mkdir -p "$(dirname "$node_dir")"
    if ! curl -fsSL "https://nodejs.org/dist/v$${ARG_NODE_VERSION}/node-v$${ARG_NODE_VERSION}-linux-$${node_arch}.tar.gz" | tar -xz -C "$(dirname "$node_dir")"; then
      echo "❌ Failed to download Node.js v$${ARG_NODE_VERSION}. T3 Code cannot run without node."
      exit 1
    fi
  fi

  export PATH="$node_dir/bin:$PATH"

  # Expose node/npm to other workspace scripts and interactive shells.
  if [ -n "$${CODER_SCRIPT_BIN_DIR:-}" ]; then
    [ -e "$${CODER_SCRIPT_BIN_DIR}/node" ] || ln -s "$node_dir/bin/node" "$${CODER_SCRIPT_BIN_DIR}/node"
    [ -e "$${CODER_SCRIPT_BIN_DIR}/npm" ] || ln -s "$node_dir/bin/npm" "$${CODER_SCRIPT_BIN_DIR}/npm"
  fi
}

ensure_node

T3_BIN="$${ARG_INSTALL_PREFIX}/node_modules/.bin/t3"

if [ -x "$T3_BIN" ] && [ "$${ARG_USE_CACHED}" = "true" ]; then
  printf "%s\n" "🥳 Found a cached copy of T3 Code, skipping install (use_cached=true)"
  "$T3_BIN" --version || true
  exit 0
fi

case "$${ARG_PACKAGE_MANAGER}" in
  npm | pnpm | bun) ;;
  *)
    echo "❌ Unsupported package_manager '$${ARG_PACKAGE_MANAGER}'. Use 'npm', 'pnpm', or 'bun'."
    exit 1
    ;;
esac

if ! command_exists "$${ARG_PACKAGE_MANAGER}"; then
  echo "❌ package_manager '$${ARG_PACKAGE_MANAGER}' was not found on PATH."
  exit 1
fi

mkdir -p "$${ARG_INSTALL_PREFIX}"
cd "$${ARG_INSTALL_PREFIX}"
[ -f package.json ] || echo '{"private":true}' > package.json

PKG_SPEC="t3@$${ARG_VERSION}"

printf "$${BOLD}Installing T3 Code ($${PKG_SPEC}) via $${ARG_PACKAGE_MANAGER}...\n"

case "$${ARG_PACKAGE_MANAGER}" in
  npm)
    npm install --no-audit --no-fund --registry "$${ARG_REGISTRY_URL}" "$${PKG_SPEC}"
    ;;
  pnpm)
    pnpm add --registry "$${ARG_REGISTRY_URL}" "$${PKG_SPEC}"
    ;;
  bun)
    bun add --registry "$${ARG_REGISTRY_URL}" "$${PKG_SPEC}"
    ;;
esac

if [ ! -x "$T3_BIN" ]; then
  echo "❌ Could not locate the t3 binary after install at $T3_BIN"
  exit 1
fi

printf "%s\n\n" "🥳 T3 Code has been installed to $${ARG_INSTALL_PREFIX}"
"$T3_BIN" --version || true
